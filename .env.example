# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Phone of the storage account, international format: +628xxxxxxxxxx
TELEGRAM_PHONE=
# Private channel id, e.g. -1001234567890. Empty: one is created on the first login (`telegram-drive login`)
TELEGRAM_CHANNEL_ID=

# Default 127.0.0.1: only a tunnel or reverse proxy on this machine can reach the API.
# 0.0.0.0 exposes it on every interface.
HOST=127.0.0.1
# Database. SQLite (one file, no server):  DATABASE_URL=sqlite:data/drive.db
# PostgreSQL (remote servers: add sslmode=require or verify-full):
DATABASE_URL=postgres://telegram_drive:password@localhost:5432/telegram_drive?sslmode=disable

PORT=5758
DATA_DIR=data
# 2000 for a normal account, 4000 for Telegram Premium
MAX_UPLOAD_MB=2000
# Optional "Log in with Telegram": a bot from @BotFather, with /setdomain set to the UI's domain.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Production: origin of the UI (Cloudflare Pages / Vercel), e.g. https://drive.example.com
ALLOWED_ORIGIN=
